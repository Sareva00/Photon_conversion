# ============================================================
# Author: Sara Evangelista
# with the help of Claude I have converted my old plotting routine 
# into a python style
# ============================================================

# --- Font sizes ---
font.size          : 16
axes.titlesize     : 24
axes.labelsize     : 18
xtick.labelsize    : 18
ytick.labelsize    : 18
legend.fontsize    : 14

# --- Axes title style ---
axes.titlelocation : center
axes.titleweight   : bold
axes.titlepad      : 10

# --- Tick style ---
xtick.direction    : in
ytick.direction    : in
xtick.minor.visible: True
ytick.minor.visible: True

xtick.major.size   : 8
ytick.major.size   : 8
xtick.minor.size   : 4
ytick.minor.size   : 4

xtick.major.pad    : 10
ytick.major.pad    : 10

xtick.top          : True
ytick.right        : True

# --- Grid ---
axes.grid          : True
axes.grid.which    : major
grid.linestyle     : --
grid.linewidth     : 0.3
grid.alpha         : 0.5

# --- Lines ---
lines.linewidth    : 1.5

# --- Figure ---
# Golden ratio height is handled in set_size() — keep figsize as a fallback default
figure.figsize     : 7.04, 4.35    # ~508pt wide, golden ratio height

# --- Layout ---
figure.autolayout  : True

# --- Formatter ---
# Scientific notation is set per-axis in code (ScalarFormatter),
# not configurable via stylesheet — keep your f = ScalarFormatter(...) helper
