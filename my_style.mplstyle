# ============================================================
# Author: Sara Evangelista
# with the help of Claude I have converted my old plotting routine 
# into a python style
# ============================================================

# --- Font sizes ---
font.size          : 12
axes.titlesize     : 16
axes.labelsize     : 16
xtick.labelsize    : 14
ytick.labelsize    : 14
legend.fontsize    : 12

# --- Axes title style ---
axes.titlelocation : center
axes.titleweight   : normal
axes.titlepad      : 10

# --- Tick style ---
xtick.direction    : in
ytick.direction    : in
xtick.minor.visible: True
ytick.minor.visible: True

xtick.major.size   : 8
ytick.major.size   : 8
xtick.minor.size   : 4
ytick.minor.size   : 4

xtick.major.pad    : 5
ytick.major.pad    : 5

xtick.top          : True
ytick.right        : True

# --- Grid ---
axes.grid          : True
axes.grid.which    : major
grid.linestyle     : --
grid.linewidth     : 0.3
grid.alpha         : 0.5

# --- Lines ---
lines.linewidth    : 1.2

# --- Layout ---
figure.autolayout  : True

# --- Formatter ---
# Scientific notation is set per-axis in code (ScalarFormatter),
# not configurable via stylesheet — keep your f = ScalarFormatter(...) helper

